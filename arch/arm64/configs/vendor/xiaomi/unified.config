# Platform
CONFIG_MACH_XIAOMI_E10=y
CONFIG_MACH_XIAOMI_E1N=y
CONFIG_MACH_XIAOMI_E1S=y
CONFIG_MACH_XIAOMI_D5X=y
CONFIG_MACH_XIAOMI_E8=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS_MI=y
CONFIG_TOUCHSCREEN_NT36XXX_MI=y
CONFIG_INPUT_PRESS_NDT=y
CONFIG_INPUT_PRESS_NDT_F60=y
CONFIG_INPUT_PRESS_NDT_M65=y
CONFIG_TOUCHSCREEN_ATMEL_MXT_MI=y
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_TOUCHSCREEN_FT5X46=y
CONFIG_TOUCHSCREEN_FT5X46_I2C=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FORCE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_I2C_FORCE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE_FORCE=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_RMI_DEV_FORCE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_SPI_FORCE is not set
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE_FORCE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_TEST_REPORTING_FORCE=y

# LEDS
CONFIG_LEDS_LM3644=y

# GPS
CONFIG_BCM_GPS_SPI_DRIVER=y

# Ricktek
CONFIG_REGULATOR_RTMV20=y

# Wireless Supply
CONFIG_IDT_P9220=y
