# Platform
CONFIG_MACH_XIAOMI_E5=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_HARDEN_BRANCH_PREDICTOR=n
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=n

# Fingerprint
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TA=y

# Camera
CONFIG_USE_ROHM_BU64753=y

# Sound
CONFIG_SND_SOC_TAS2557=y
CONFIG_SND_ELLIPTIC=y

# Speaker ID
CONFIG_MFD_SPK_ID=y

# Touchscreen
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_TOUCHSCREEN_FTS_MI=y
CONFIG_TOUCHSCREEN_FTS_FT3518_MI=y
CONFIG_TOUCHSCREEN_FTS_POWER_SUPPLY_MI=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE_SENSOR=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE_GAMEMODE=y

# GPS
CONFIG_BCM_GPS_SPI_DRIVER=y

# HALL
CONFIG_HALLS=y

# Wireless Supply
CONFIG_IDT_P9220=y
