# DebugFS
CONFIG_DEBUG_FS=y
CONFIG_MSM_TZ_LOG=y
CONFIG_CMA_DEBUGFS=y
CONFIG_REGMAP_ALLOW_WRITE_DEBUGFS=y
CONFIG_IPA_UT=y
CONFIG_IOMMU_TESTS=y
CONFIG_QMP_DEBUGFS_CLIENT=y

#Debug
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_TEST_SUSPEND=y

# Persistent store
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_SQ=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OOPS=y
CONFIG_MTD_BLOCK2MTD=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS=n
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=n
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM=n
CONFIG_TOUCHSCREEN_ST=n
CONFIG_TOUCHSCREEN_COMMON=y

# Vibrator
CONFIG_INPUT_QTI_HAPTICS=n
CONFIG_LEDS_QPNP_HAPTICS=y

# CPUFREQ Interface
# OSM Clock
CONFIG_CLOCK_CPU_OSM_SDM845=n
CONFIG_LEGACY_ENERGY_MODEL_DT=n
# CPUFREQ_HW
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_ARM_QCOM_DEVFREQ_FW=y

# Clock Source drivers
CONFIG_ARM_ARCH_TIMER_VCT_ACCESS=y

# Timers subsystem
CONFIG_NO_HZ_IDLE=y

# ION
CONFIG_ION_CAMERA_HEAP=y

# SPCOM
CONFIG_MSM_SPCOM=n
CONFIG_MSM_SPCOM_LEGACY=y

# Scheduler features
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=n

# Backlight - PMI8998
CONFIG_BACKLIGHT_QCOM_SPMI_WLED=y
CONFIG_BACKLIGHT_QCOM_WLED_MAINLINE=n

#
# Rpmsg drivers
#
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_GLINK_SPSS=y
CONFIG_RPMSG_QCOM_GLINK_SPI=y

#
# Compile-time checks and compiler options
#
CONFIG_FRAME_WARN=4096

# CPUIDLE
# CONFIG_CPU_IDLE_GOV_MENU is not set

# SBALANCE
CONFIG_IRQ_SBALANCE=y
CONFIG_SBALANCE_EXCLUDE_CPUS="3,6,7"

# Xiaomi
CONFIG_CIFS=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_CODEPAGE_950=y
CONFIG_NLS_UTF8=y
