# DebugFS
CONFIG_DEBUG_FS=y
CONFIG_MSM_TZ_LOG=y
CONFIG_CMA_DEBUGFS=y
CONFIG_REGMAP_ALLOW_WRITE_DEBUGFS=y
CONFIG_IPA_UT=y
CONFIG_IOMMU_TESTS=y
CONFIG_QMP_DEBUGFS_CLIENT=y

#Debug
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_TEST_SUSPEND=y

# Persistent store
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_SQ=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OOPS=y
CONFIG_MTD_BLOCK2MTD=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS=n
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=n
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM=n
CONFIG_TOUCHSCREEN_ST=n
CONFIG_TOUCHSCREEN_COMMON=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# Vibrator
CONFIG_INPUT_QTI_HAPTICS=n
CONFIG_LEDS_QPNP_HAPTICS=y

# CPUFREQ Interface
# OSM Clock
CONFIG_CLOCK_CPU_OSM_SDM845=y
CONFIG_LEGACY_ENERGY_MODEL_DT=y
# CPUFREQ_HW
CONFIG_ARM_QCOM_CPUFREQ_HW=n
CONFIG_ARM_QCOM_DEVFREQ_FW=n

# Clock Source drivers
CONFIG_ARM_ARCH_TIMER_VCT_ACCESS=y

# Timers subsystem
CONFIG_NO_HZ_IDLE=y

# ION
CONFIG_ION_CAMERA_HEAP=y
CONFIG_ION_SYSTEM_HEAP=y

# SPCOM
CONFIG_MSM_SPCOM=n
CONFIG_MSM_SPCOM_LEGACY=y

# Xiaomi
CONFIG_BOOT_INFO=y

# Scheduler features
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# Backlight - PMI8998
CONFIG_BACKLIGHT_QCOM_SPMI_WLED=y
CONFIG_BACKLIGHT_QCOM_WLED_MAINLINE=n

#
# Rpmsg drivers
#
CONFIG_RPMSG=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_QCOM_GLINK_NATIVE=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_GLINK_SPSS=y
CONFIG_RPMSG_QCOM_GLINK_SPI=y
CONFIG_RPMSG_QCOM_SMD=y
# CONFIG_RPMSG_VIRTIO is not set
CONFIG_MSM_RPM_SMD=y

# TEO
# CONFIG_CPU_IDLE_GOV_TEO_MAINLINE is not set
# CONFIG_CPU_IDLE_GOV_MENU is not set

