# Platform
CONFIG_MACH_XIAOMI=y
CONFIG_MACH_XIAOMI_SDM845=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# DTBO
# CONFIG_BUILD_ARM64_DT_OVERLAY is not set

# exFAT
CONFIG_EXFAT_FS=y

# EROFS
CONFIG_EROFS_FS=y

# Fingerprint
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_FINGERPRINT_SYNAPTICS4302=y

# Haptics
# CONFIG_INPUT_QTI_HAPTICS is not set
CONFIG_LEDS_QPNP_HAPTICS=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"
CONFIG_CMDLINE_EXTEND=y

# Speaker-ID
CONFIG_MFD_SPK_ID=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y

# Touchscreen
CONFIG_TOUCHSCREEN_COMMON=y

# Xiaomi - dipper-q-oss
CONFIG_CIFS=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_CODEPAGE_950=y
CONFIG_NLS_UTF8=y
