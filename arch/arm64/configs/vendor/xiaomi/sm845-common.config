# DebugFS
CONFIG_DEBUG_FS=n
CONFIG_MSM_TZ_LOG=n
CONFIG_CMA_DEBUGFS=n
CONFIG_REGMAP_ALLOW_WRITE_DEBUGFS=n
CONFIG_IPA_UT=n
CONFIG_IOMMU_TESTS=n
CONFIG_QMP_DEBUGFS_CLIENT=n

# Persistent store
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_SQ=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OOPS=y
CONFIG_MTD_BLOCK2MTD=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS=n
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=n
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM=n
CONFIG_TOUCHSCREEN_ST=n
CONFIG_TOUCHSCREEN_COMMON=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# Vibrator
CONFIG_INPUT_QTI_HAPTICS=y

# CPUFREQ Interface
# OSM Clock
CONFIG_CLOCK_CPU_OSM_SDM845=y
CONFIG_LEGACY_ENERGY_MODEL_DT=y
# CPUFREQ_HW
CONFIG_ARM_QCOM_CPUFREQ_HW=n
CONFIG_ARM_QCOM_DEVFREQ_FW=n

# Clock Source drivers
CONFIG_ARM_ARCH_TIMER_VCT_ACCESS=y

# Timers subsystem
CONFIG_NO_HZ_IDLE=y

# ION
CONFIG_ION_CAMERA_HEAP=y

# SPCOM
CONFIG_MSM_SPCOM=n
CONFIG_MSM_SPCOM_LEGACY=y

# LTO_THIN
CONFIG_LTO=y
CONFIG_THINLTO=y
# CONFIG_LTO_NONE is not set
CONFIG_LTO_CLANG=y
# CONFIG_CFI_CLANG is not set
